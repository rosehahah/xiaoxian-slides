{
  "name": "xiaoxian-slides",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小苋演示：可离线播放的 HTML 演示 Skill 与模板",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
